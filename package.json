{
  "name": "dsh-chime",
  "version": "0.2.1",
  "description": "DSH 提示音插件：任务完成 / 任务卡住 / 任务失败三类事件各带一个内置音，可总开关、可调音量、可导入自己的音频；音频只存在本机浏览器，不上传。",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "notification",
    "sound",
    "chime"
  ],
  "exports": {
    ".": "./dsh/index.js",
    "./client": "./dsh/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    }
  },
  "files": [
    "dsh",
    "sounds",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "author": "chichi233",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chichi233/dsh-chime.git"
  },
  "homepage": "https://github.com/chichi233/dsh-chime#readme",
  "bugs": {
    "url": "https://github.com/chichi233/dsh-chime/issues"
  }
}
